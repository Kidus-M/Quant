# Copy to .env (gitignored). Never commit real values.
FRED_API_KEY=

# Market data. A free OANDA practice account, personal access token only.
# No account id is needed or read: the adapter reads candles and cannot place
# an order. See src/data/oanda.py and tests/test_oanda.py.
OANDA_API_TOKEN=
# practice | live. Must match where the token was issued.
OANDA_ENVIRONMENT=practice

# Phase 2 only -- do not populate until phase 1 passes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
