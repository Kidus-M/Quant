# Data + outputs are never committed.
# Leading slash anchors these to the repository root. Without it, "data/" matches
# a directory of that name at ANY depth -- which silently excluded the entire
# src/data/ package from every commit, and shipped a deploy that could not import
# its own data layer.
/data/
/reports/
notebooks/*.ipynb_checkpoints/

# Credentials
.env
*.env
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
